{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3100",
    "generate": "nuxt generate",
    "build": "nuxt typecheck && nuxt generate",
    "preview": "npx -y serve .output/public",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "lint": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write --experimental-cli app/"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
