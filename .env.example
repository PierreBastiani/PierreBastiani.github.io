# Contact details, kept out of the public repository. Copy to .env and fill in.
# In CI they come from the GitHub Actions secrets CONTACT_EMAIL, CONTACT_PHONE and LEGAL_ADDRESS.
NUXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NUXT_CONTACT_PHONE=06 12 34 56 78
# The business address the legal notice shows (/mentions-legales/ only): street, postcode, town.
NUXT_LEGAL_ADDRESS=1 rue de l’Exemple, 06000 Exempleville
